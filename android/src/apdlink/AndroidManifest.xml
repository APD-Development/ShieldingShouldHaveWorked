<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<!-- Developer build only: a read-only window into this phone's run history for the APD Simulator app.
	     protectionLevel="signature": only an app signed with the same key can open it. Nothing can be written through it. -->
	<permission
		android:name="${applicationId}.permission.READ_HISTORY"
		android:protectionLevel="signature" />
	<application>
		<provider
			android:name="com.shatteredpixel.shatteredpixeldungeon.android.HistoryLinkProvider"
			android:authorities="${applicationId}.history"
			android:exported="true"
			android:readPermission="${applicationId}.permission.READ_HISTORY"
			android:writePermission="${applicationId}.permission.READ_HISTORY" />
	</application>
</manifest>
